{
  "manifest_version": 3,
  "name": "Coherent Outreach Bridge",
  "version": "0.1.13",
  "description": "Executes LinkedIn outreach commands queued by the Coherent Outreach backend.",
  "permissions": ["storage", "alarms", "scripting", "sidePanel"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content_linkedin.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coherent Outreach",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
